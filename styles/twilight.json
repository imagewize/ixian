{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"title": "Twilight",
	"version": 3,
	"settings": {
		"custom": {
			"color": {
				"control-border": "#6B7A90"
			}
		},
		"color": {
			"palette": [
				{ "name": "Base", "slug": "base", "color": "#0F1620" },
				{ "name": "Tertiary", "slug": "tertiary", "color": "#18212E" },
				{ "name": "Border Light", "slug": "border-light", "color": "#2A3546" },
				{ "name": "Contrast", "slug": "contrast", "color": "#F6F8FB" },
				{ "name": "Main", "slug": "main", "color": "#A5B4FC" },
				{ "name": "Primary", "slug": "primary", "color": "#818CF8" },
				{ "name": "Accent", "slug": "accent", "color": "#2DD4BF" },
				{ "name": "Secondary", "slug": "secondary", "color": "#C3CBD9" },
				{ "name": "Main Accent", "slug": "main-accent", "color": "#94A3B8" },
				{ "name": "Primary Accent", "slug": "primary-accent", "color": "#1E2647" },
				{ "name": "Primary Alt", "slug": "primary-alt", "color": "#A5B4FC" },
				{ "name": "White", "slug": "white", "color": "#FFFFFF" },
				{ "name": "Terracotta", "slug": "terracotta", "color": "#FB923C" },
				{ "name": "Sand Deep", "slug": "sand-deep", "color": "#2A3546" },
				{ "name": "Indigo", "slug": "indigo", "color": "#C7D2FE" }
			],
			"gradients": [
				{
					"name": "Core Bloom",
					"slug": "core-bloom",
					"gradient": "linear-gradient(135deg, #818CF8 0%, #0F1620 100%)"
				},
				{
					"name": "Signal",
					"slug": "signal",
					"gradient": "linear-gradient(135deg, #FB923C 0%, #818CF8 100%)"
				},
				{
					"name": "Steel",
					"slug": "steel",
					"gradient": "linear-gradient(180deg, #0F1620 0%, #18212E 100%)"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"elements": {
			"button": {
				"color": {
					"text": "var(--wp--preset--color--base)",
					"background": "var(--wp--preset--color--primary)"
				}
			}
		}
	}
}
